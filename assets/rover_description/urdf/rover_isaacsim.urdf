<?xml version="1.0" encoding="utf-8"?>
<!-- rover_isaacsim.urdf -->
<!-- Plain URDF derived from the rover xacro for Isaac Sim import. -->
<!-- Gazebo and ros2_control plugins are intentionally omitted. -->
<robot name="rover">

  <!-- Root link carries the body visual to avoid importer warnings on empty roots. -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="200.0"/>
      <inertia ixx="20.0" ixy="0" ixz="0" iyy="20.0" iyz="0" izz="20.0"/>
    </inertial>
    <visual>
      <origin xyz="0.1 0 -0.04" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/visual/rover.dae" scale="0.0105 0.00825 0.01"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.65 0.22 0.08"/>
      </geometry>
    </collision>
  </link>

  <!-- Wheel geometry is the odometry reference: radius = 0.08 m, diameter = 0.16 m. -->
  <link name="wheel_rr">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/visual/rover_wheel.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.05" radius="0.08"/>
      </geometry>
    </collision>
  </link>

  <link name="wheel_fr">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/visual/rover_wheel.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.05" radius="0.08"/>
      </geometry>
    </collision>
  </link>

  <link name="wheel_rl">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="3.1416 0 0"/>
      <geometry>
        <mesh filename="../meshes/visual/rover_wheel.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.05" radius="0.08"/>
      </geometry>
    </collision>
  </link>

  <link name="wheel_fl">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="3.1416 0 0"/>
      <geometry>
        <mesh filename="../meshes/visual/rover_wheel.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.05" radius="0.08"/>
      </geometry>
    </collision>
  </link>

  <!-- Low passive losses so Isaac Sim can drive the wheels with velocity targets. -->
  <joint name="wheel_rr_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rr"/>
    <origin xyz="-0.3 0.24 -0.1" rpy="-1.57079632679 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="40.0" velocity="30.0"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <joint name="wheel_rl_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rl"/>
    <origin xyz="-0.3 -0.24 -0.1" rpy="-1.57079632679 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="40.0" velocity="30.0"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <joint name="wheel_fl_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_fl"/>
    <origin xyz="0.3 -0.24 -0.1" rpy="-1.57079632679 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="40.0" velocity="30.0"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <joint name="wheel_fr_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_fr"/>
    <origin xyz="0.3 0.24 -0.1" rpy="-1.57079632679 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="40.0" velocity="30.0"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <link name="imu_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="1e-8" ixy="0" ixz="0" iyy="1e-8" iyz="0" izz="1e-8"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.02 0.02 0.01"/>
      </geometry>
      <material name="imu_visual">
        <color rgba="0.2 0.8 0.2 0.5"/>
      </material>
    </visual>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Front RGB-D camera styled after Intel RealSense D435/D455. -->
  <link name="front_rgbd_camera_link">
    <visual>
      <geometry>
        <box size="0.09 0.025 0.025"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="camera_body_dark">
        <color rgba="0.15 0.15 0.18 1.0"/>
      </material>
    </visual>
    <visual name="left_lens">
      <geometry>
        <cylinder length="0.01" radius="0.006"/>
      </geometry>
      <origin xyz="0.04 0.008 0" rpy="0 1.57079632679 0"/>
      <material name="camera_lens">
        <color rgba="0.05 0.05 0.08 1.0"/>
      </material>
    </visual>
    <visual name="right_lens">
      <geometry>
        <cylinder length="0.01" radius="0.006"/>
      </geometry>
      <origin xyz="0.04 -0.008 0" rpy="0 1.57079632679 0"/>
      <material name="camera_lens">
        <color rgba="0.05 0.05 0.08 1.0"/>
      </material>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.09"/>
      <inertia ixx="5e-5" ixy="0.0" ixz="0.0" iyy="5e-5" iyz="0.0" izz="5e-5"/>
    </inertial>
  </link>

  <joint name="front_rgbd_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_rgbd_camera_link"/>
    <origin xyz="0.28 0 0.2" rpy="0 0 0"/>
  </joint>

  <link name="front_rgb_frame">
    <visual>
      <geometry>
        <box size="0.001 0.001 0.001"/>
      </geometry>
      <material name="frame_invisible">
        <color rgba="0 0 0 0"/>
      </material>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="1e-8" ixy="0.0" ixz="0.0" iyy="1e-8" iyz="0.0" izz="1e-8"/>
    </inertial>
  </link>

  <joint name="front_rgb_frame_joint" type="fixed">
    <parent link="front_rgbd_camera_link"/>
    <child link="front_rgb_frame"/>
    <origin xyz="0.045 0 0" rpy="0 0 0"/>
  </joint>

  <link name="front_rgb_optical_frame">
    <visual>
      <geometry>
        <box size="0.001 0.001 0.001"/>
      </geometry>
      <material name="frame_invisible">
        <color rgba="0 0 0 0"/>
      </material>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="1e-8" ixy="0.0" ixz="0.0" iyy="1e-8" iyz="0.0" izz="1e-8"/>
    </inertial>
  </link>

  <joint name="front_rgb_optical_joint" type="fixed">
    <parent link="front_rgb_frame"/>
    <child link="front_rgb_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>

  <link name="front_depth_frame">
    <visual>
      <geometry>
        <box size="0.001 0.001 0.001"/>
      </geometry>
      <material name="frame_invisible">
        <color rgba="0 0 0 0"/>
      </material>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="1e-8" ixy="0.0" ixz="0.0" iyy="1e-8" iyz="0.0" izz="1e-8"/>
    </inertial>
  </link>

  <joint name="front_depth_frame_joint" type="fixed">
    <parent link="front_rgbd_camera_link"/>
    <child link="front_depth_frame"/>
    <origin xyz="0.045 0 0" rpy="0 0 0"/>
  </joint>

  <link name="front_depth_optical_frame">
    <visual>
      <geometry>
        <box size="0.001 0.001 0.001"/>
      </geometry>
      <material name="frame_invisible">
        <color rgba="0 0 0 0"/>
      </material>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="1e-8" ixy="0.0" ixz="0.0" iyy="1e-8" iyz="0.0" izz="1e-8"/>
    </inertial>
  </link>

  <joint name="front_depth_optical_joint" type="fixed">
    <parent link="front_depth_frame"/>
    <child link="front_depth_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>

  <link name="wheel_odom_frame">
    <visual>
      <geometry>
        <box size="0.001 0.001 0.001"/>
      </geometry>
      <material name="frame_invisible">
        <color rgba="0 0 0 0"/>
      </material>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="1e-8" ixy="0.0" ixz="0.0" iyy="1e-8" iyz="0.0" izz="1e-8"/>
    </inertial>
  </link>

  <joint name="wheel_odom_joint" type="fixed">
    <parent link="base_link"/>
    <child link="wheel_odom_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

</robot>
