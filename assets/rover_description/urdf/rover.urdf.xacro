<?xml version="1.0" encoding="utf-8"?>
<!-- rover.urdf.xacro — rover with camera mounted -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="$(arg prefix)">

  <!-- ───── launch-time arguments (must stay at the top) ───── -->
  <xacro:arg name="prefix" default="rover"/>
  <xacro:arg name="description_pkg" default="rover_description"/>

  <!-- bridge prefix and description_pkg args into properties -->
  <xacro:property name="prefix" value="$(arg prefix)"/>
  <xacro:property name="description_pkg" value="$(arg description_pkg)"/>

  <!-- arguments required for ros2_control macro -->
  <xacro:arg name="world_name" default="world"/>
  <xacro:arg name="agent_ns" default=""/>
  <xacro:arg name="use_sim_time" default="false"/>
  <xacro:arg name="simulation_controllers_config_file" default="$(find rover_gazebo)/config/gazebo_rover_controllers.yaml"/>
  <xacro:arg name="ff_vel" default="3.0"/>
  <xacro:arg name="ff_accel" default="1.2"/>
  <xacro:arg name="add_sensors_plugin" default="false"/>

  <!-- now sim_ctrl_file can stay as-is -->
  <xacro:property name="sim_ctrl_file" value="$(arg simulation_controllers_config_file)"/>

  <!-- include ros2_control definition -->
  <xacro:include filename="$(find rover_description)/urdf/ros2_control/rover.ros2_control.xacro"/>
  <xacro:include filename="$(find rover_description)/urdf/rover.gazebo.xacro"/>

  <!-- ─────────────── Body ─────────────── -->
  <link name="${prefix}_base"/>
  <joint name="${prefix}_base_fixed" type="fixed">
    <parent link="${prefix}_base"/>
    <child link="${prefix}_body"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="${prefix}_body">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
    <visual>
      <origin xyz="0.1 0 -0.04" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find ${description_pkg})/meshes/visual/rover.dae" scale="0.0105 0.00825 0.01"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.65 0.22 0.08"/>
      </geometry>
    </collision>
  </link>

  <link name="${prefix}_wheel_RR">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.005" ixy="0.0" ixz="0.0" iyy="0.005" iyz="0.0" izz="0.005"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find ${description_pkg})/meshes/visual/rover_wheel.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.05" radius="0.1"/>
      </geometry>
    </collision>
  <gazebo reference="${prefix}_wheel_RR">
    <mu1>2.8</mu1> 
    <mu2>3.8</mu2> 
    <friction_model>cone</friction_model> 
  </gazebo>
  </link>

  <link name="${prefix}_wheel_FR">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.005" ixy="0.0" ixz="0.0" iyy="0.005" iyz="0.0" izz="0.005"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find ${description_pkg})/meshes/visual/rover_wheel.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.05" radius="0.1"/>
      </geometry>
    </collision>
  <gazebo reference="${prefix}_wheel_FR">
    <mu1>2.8</mu1> 
    <mu2>3.8</mu2>     
    <friction_model>cone</friction_model> 
  </gazebo>
  </link>

  <link name="${prefix}_wheel_RL">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.005" ixy="0.0" ixz="0.0" iyy="0.005" iyz="0.0" izz="0.005"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="3.1416 0 0"/>
      <geometry>
        <mesh filename="file://$(find ${description_pkg})/meshes/visual/rover_wheel.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.05" radius="0.1"/>
      </geometry>
    </collision>
  <gazebo reference="${prefix}_wheel_RL">
    <mu1>2.8</mu1> 
    <mu2>3.8</mu2> 
    <friction_model>cone</friction_model> 
  </gazebo>
  </link>

  <link name="${prefix}_wheel_FL">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.005" ixy="0.0" ixz="0.0" iyy="0.005" iyz="0.0" izz="0.005"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="3.1416 0 0"/>
      <geometry>
        <mesh filename="file://$(find ${description_pkg})/meshes/visual/rover_wheel.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.05" radius="0.1"/>
      </geometry>
    </collision>

  <gazebo reference="${prefix}_wheel_FL">
    <mu1>2.8</mu1> 
    <mu2>3.8</mu2> 
    <friction_model>cone</friction_model> 
  </gazebo>

  </link>

  <!-- wheel joints -->
  <joint name="${prefix}_base_to_RR" type="continuous">
    <parent link="${prefix}_body"/>
    <child link="${prefix}_wheel_RR"/>
    <origin xyz="-0.3   0.24 -0.1" rpy="-1.57079632679 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="50.0" velocity="50.0"/>
    <dynamics damping="0.2" friction="9.0"/>
  </joint>

  <joint name="${prefix}_base_to_RL" type="continuous">
    <parent link="${prefix}_body"/>
    <child link="${prefix}_wheel_RL"/>
    <origin xyz="-0.3   -0.24 -0.1" rpy="-1.57079632679 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="50.0" velocity="50.0"/>
    <dynamics damping="0.2" friction="9.0"/>
  </joint>

  <joint name="${prefix}_base_to_FL" type="continuous">
    <parent link="${prefix}_body"/>
    <child link="${prefix}_wheel_FL"/>
    <origin xyz="0.3   -0.24 -0.1" rpy="-1.57079632679 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="50.0" velocity="50.0"/>
    <dynamics damping="0.2" friction="9.0"/>
  </joint>

  <joint name="${prefix}_base_to_FR" type="continuous">
    <parent link="${prefix}_body"/>
    <child link="${prefix}_wheel_FR"/>
    <origin xyz="0.3   0.24 -0.1" rpy="-1.57079632679 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="50.0" velocity="50.0"/>
    <dynamics damping="0.2" friction="9.0"/>
  </joint>

  <!-- ───────── instantiate ros2_control plugin and controllers ───────── -->
  <xacro:rover_ros2_control
      prefix="${prefix}"
      world_name="$(arg world_name)"
      agent_ns="$(arg agent_ns)"
      use_sim_time="$(arg use_sim_time)"
      simulation_controllers_config_file="${sim_ctrl_file}"
      ff_vel="$(arg ff_vel)"
      ff_accel="$(arg ff_accel)"/>

  <!-- Gazebo systems (PosePublisher etc.) -->
<xacro:rover_gazebo
    prefix="${prefix}"
    world_name="$(arg world_name)"
    agent_ns="$(arg agent_ns)"
    use_sim_time="$(arg use_sim_time)"
    add_sensors_plugin="$(arg add_sensors_plugin)"/>

  <!-- Camera Setup -->

  <link name="${prefix}_camera_pole">
    <visual>
      <geometry>
        <cylinder length="0.18" radius="0.05"/>
      </geometry>
                <origin xyz="0 -0.1 0" rpy="1.57079632679 0 0"/>
    </visual>
   <!--  <collision>
      <geometry>
        <cylinder length="0.5" radius="0.02"/>
      </geometry>
    </collision>  -->
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0"
               iyy="0.01" iyz="0.0"
               izz="0.01"/>
    </inertial>
  </link>


  <joint name="${prefix}_base_to_camera_pole" type="fixed">
    <parent link="${prefix}_body"/>
    <child link="${prefix}_camera_pole"/>
    <origin xyz="0.2 0 0.2" rpy="1.57079632679 0 0"/>
  </joint>

  <link name="${prefix}_camera_link">
     <visual>
      <geometry>
        <cylinder length="0.04" radius="0.07"/>
      </geometry>
                <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
    </visual>

  <visual name="cam_tip">
    <geometry>
      <cylinder length="0.02" radius="0.02"/>
    </geometry>
    <origin xyz="0.065 0 0" rpy="0 1.57079632679 0"/>
    <material name="cam_tip_blue">
      <!-- R G B A -->
      <color rgba="0.2 0.6 1.0 1.0"/>
    </material>
  </visual>

      <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0"
               iyy="0.01" iyz="0.0"
               izz="0.01"/>
    </inertial>
  </link>

  <joint name="${prefix}_camera_joint" type="fixed">
    <parent link="${prefix}_camera_pole"/>
    <child link="${prefix}_camera_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

</robot>
<!-- end of file -->
