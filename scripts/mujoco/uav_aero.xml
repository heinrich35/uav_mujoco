<mujoco model="uav_aero">

  <!-- ==============================================
       Compiler & Options
       ============================================== -->
  <compiler angle="degree" eulerseq="xyz" meshdir="/home/heinz/isaaclab_uav/assets"/>

  <option timestep="0.005" gravity="0 0 -9.81"
          impratio="20" tolerance="1e-8" ls_tolerance="1e-8" noslip_tolerance="1e-8">
    <!-- Solver settings for better contact stability -->
    <flag contact="enable"/>
  </option>

  <!-- Soft contact parameters: prevent violent ground launch.
       The drone mesh extends ~0.6 m below the body origin when pitched,
       so lowering initial z below ~1.6 m causes ground penetration. -->
  <contact>
    <pair name="uav_ground" geom1="ground" geom2="uav_body"
          solref="0.01 0.9" solimp="0.95 0.99 0.001 0.5 2"
          condim="3" friction="0.5 0.3 0.1"/>
    <pair name="uav_rail" geom1="rail_geom" geom2="uav_body"
          solref="0.01 0.9" solimp="0.95 0.99 0.001 0.5 2"
          condim="3" friction="0.5 0.3 0.1"/>
  </contact>

  <visual>
    <map stiffness="1000" fogstart="10" fogend="50"/>
    <quality shadowsize="2048"/>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3"/>
  </visual>

  <!-- ==============================================
       Assets: Meshes
       ============================================== -->
  <asset>
    <!-- UAV collision/visual mesh -->
    <mesh name="uav_mesh" file="shahed-136/source/shahed_collision_2.stl"/>
    <!-- Rail collision object mesh -->
    <mesh name="rail_mesh" file="shahed-136/source/rail_collision.stl"/>
  </asset>

  <!-- ==============================================
       World Body
       ============================================== -->
  <worldbody>

    <!-- Ground plane (infinite flat plane at z=0) -->
    <geom name="ground" type="plane" size="50 50 0.1" pos="0 0 0" rgba="0.3 0.4 0.5 1"/>

    <!-- Lighting reference -->
    <light directional="true" diffuse="0.8 0.8 0.8" specular="0.2 0.2 0.2"
           pos="5 5 10" dir="-0.5 -0.5 -1"/>

    <!-- ==========================================
         UAV Drone (fixed-wing, free-flying)
         Initial pose: pos=(0, 0, 2.0), pitch=12.8°
         (z raised from requested 0.9 to 2.0 to avoid
          ground penetration — the Shahed mesh extends
          ~0.6 m below the body origin when pitched.)
         ========================================== -->
    <body name="uav" pos="0 0 2.0" euler="0 12.8 0">
      <!-- 6-DoF free joint -->
      <joint name="uav_joint" type="free"/>

      <!-- Inertial properties: mass=200 kg, inertia from URDF -->
      <inertial pos="0 0 0" mass="200" diaginertia="40 40 20"/>

      <!-- Visual + collision geometry using STL mesh -->
      <geom name="uav_body" type="mesh" mesh="uav_mesh"
            rgba="0.6 0.6 0.65 1"/>

      <!-- Front marker: small sphere at nose to indicate heading -->
      <site name="uav_nose" pos="-0.8 0 0" size="0.02" rgba="1 0 0 1"/>
      <!-- COM marker -->
      <site name="uav_com" pos="0 0 0" size="0.03" rgba="0 1 0 1"/>
    </body>

    <!-- ==========================================
         Static Rail Object
         Position: (0, 0, 0), orientation: identity
         ========================================== -->
    <body name="rail" pos="0 0 0" quat="1 0 0 0">
      <!-- Fixed base -- no free joint = static -->
      <geom name="rail_geom" type="mesh" mesh="rail_mesh"
            rgba="0.7 0.6 0.5 1"/>
    </body>

  </worldbody>

  <!-- ==============================================
       Sensors
       ============================================== -->
  <sensor>
    <!-- Body linear velocity in world frame -->
    <framelinvel name="uav_vel" objtype="body" objname="uav"/>
    <!-- Body angular velocity -->
    <framelinvel name="uav_angvel" objtype="body" objname="uav"/>
  </sensor>

</mujoco>
